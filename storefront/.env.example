# Local development (Vite proxies /api → http://127.0.0.1:3000)
# VITE_API_URL=/api/v1
#
# VPS production (Nginx/Docker reverse proxy — same origin):
VITE_API_URL=/api/v1
VITE_BASE=/
VITE_SITE_URL=https://daralonotha.com
#
# Or absolute URL if API is on another host:
# VITE_API_URL=https://daralonotha.com/api/v1
