# Development defaults. For production copy deploy/.env.production.example
NODE_ENV=development
PORT=3000
APP_NAME=دار الأنوثة
APP_URL=http://localhost:3000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_CURRENCY=LYD
APP_CURRENCY_SYMBOL=د.ل
APP_TIMEZONE=Africa/Tripoli

# PostgreSQL (required for current Prisma schema). Local example:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/dar_alonotha?schema=public"

# Production (Railway): DATABASE_URL=${{Postgres.DATABASE_URL}}
# Never use file:/data/app.db in production — SQLite fallback is forbidden.

# Optional local upload root (production uses RAILWAY_VOLUME_MOUNT_PATH=/app/uploads)
# UPLOAD_ROOT=./uploads

# One-time SQLite → PostgreSQL migration tooling:
# SQLITE_SOURCE_URL="file:./migration-data/FINAL.db?mode=ro"
# POSTGRES_TARGET_URL="postgresql://..."
