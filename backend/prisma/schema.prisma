generator client {
  provider      = "prisma-client-js"
  // native = local/dev; debian-openssl-3.0.x = node:20-bookworm-slim (Docker/VPS)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentType {
  NONE
  SALARY
  COMMISSION
}

enum SalaryPaymentStatus {
  PENDING
  PAID
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderSource {
  FACEBOOK
  WEBSITE
  POS
  WHOLESALE
  OTHER
}

enum OrderStatus {
  DRAFT
  NEW
  CONFIRMED
  PREPARING
  READY
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  COD
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DeliveryType {
  INTERNAL
  EXTERNAL
  PICKUP
  STORE
}

enum FulfillmentType {
  INTERNAL
  EXTERNAL
}

enum LocalOrderStatus {
  PENDING
  IN_WAREHOUSE
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum InventoryMovementType {
  IN
  OUT
  SALE
  ADJUST
  RESERVE
  RELEASE
  RETURN
  TRANSFER
  DAMAGE
}

enum FacebookPageStatus {
  ACTIVE
  INACTIVE
}

enum PageMemberRole {
  MANAGER
  ADMIN
  AGENT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
  CANCELLED
}

enum ClientPlatform {
  ANDROID
  IOS
  WEB
  ADMIN
}

enum BranchType {
  WHOLESALE_RETAIL
  RETAIL
}

enum PushProvider {
  FCM
  APNS
}

enum DeliveryGender {
  MALE
  FEMALE
}

// ─── Auth / RBAC ─────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  locale       String     @default("ar")
  employmentType EmploymentType @default(NONE)
  monthlySalary  Decimal?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles              UserRole[]
  facebookPages      FacebookPageEmployee[]
  managedPages       FacebookPage[]         @relation("PageManager")
  portalPage         FacebookPage?          @relation("PagePortalUser")
  salesOrders        Order[]                @relation("SalesAgentOrders")
  cashierOrders      Order[]                @relation("CashierOrders")
  createdOrders      Order[]                @relation("CreatedByOrders")
  warehouseMovements InventoryMovement[]    @relation("MovementBy")
  assignedDeliveries Delivery[]             @relation("DeliveryAgent")
  courierProfile     Courier?
  reservations       StockReservation[]     @relation("AgentReservations")
  commissions        CommissionEntry[]      @relation("AgentCommissions")
  salaryPayments     SalaryPayment[]
  notifications      Notification[]         @relation("UserNotifications")
  auditLogs          AuditLog[]
  sessions           AuthSession[]
  devices            Device[]
  branch             Branch?

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  nameAr      String
  nameEn      String?
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  nameAr      String
  nameEn      String?
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Settings ────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

// ─── Catalog ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  parentId  String?
  nameAr    String
  nameEn    String?
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  sku            String?       @unique
  nameAr         String
  nameEn         String?
  description    String?
  categoryId     String?
  brand          String?
  status         ProductStatus @default(DRAFT)
  costPrice      Decimal?
  wholesalePrice Decimal?
  retailPrice    Decimal
  /// @deprecated use retailPrice
  basePrice      Decimal       @default(0)
  currency       String        @default("LYD")
  isTrackStock   Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@index([status])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String   @unique
  barcode        String?  @unique
  nameAr         String?
  nameEn         String?
  color          String?
  size           String?
  /// صورة هذا اللون (تُنسخ لكل مقاسات نفس اللون)
  imageUrl       String?
  costPrice      Decimal?
  wholesalePrice Decimal?
  retailPrice    Decimal  @default(0)
  /// @deprecated use retailPrice
  price          Decimal  @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItems    StockItem[]
  orderItems    OrderItem[]
  reservations  StockReservation[]
  transferItems StockTransferItem[]

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  /// إن وُجدت تُعرض هذه الصورة عند اختيار هذا اللون في المتجر
  color     String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, color])
  @@map("product_images")
}

// ─── Warehouse / Inventory ───────────────────────────────

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String?
  address   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems StockItem[]
  movements  InventoryMovement[]
  orders     Order[]
  branch     Branch?

  @@map("warehouses")
}

model Branch {
  id           String     @id @default(cuid())
  name         String     @map("branchName")
  username     String     @unique
  passwordHash String     @map("password_hash")
  type         BranchType @default(RETAIL)
  isMain       Boolean    @default(false)
  isActive     Boolean    @default(true)
  warehouseId  String     @unique
  userId       String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  stockItems   StockItem[]
  orders       Order[]
  transfersOut StockTransfer[]  @relation("TransferFrom")
  transfersIn  StockTransfer[]  @relation("TransferTo")

  @@index([isActive])
  @@map("branches")
}

model StockItem {
  id               String   @id @default(cuid())
  warehouseId      String
  branchId         String?
  variantId        String
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  reorderLevel     Int      @default(0)
  updatedAt        DateTime @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  branch    Branch?        @relation(fields: [branchId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, variantId])
  @@index([branchId, variantId])
  @@map("stock_items")
}

model StockTransfer {
  id           String   @id @default(cuid())
  fromBranchId String
  toBranchId   String
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())

  fromBranch Branch             @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch             @relation("TransferTo", fields: [toBranchId], references: [id])
  items      StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  variantId  String
  quantity   Int

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

model InventoryMovement {
  id          String                @id @default(cuid())
  warehouseId String
  variantId   String
  type        InventoryMovementType
  quantity    Int
  reference   String?
  orderId     String?
  reason      String?
  notes       String?
  createdById String?
  createdAt   DateTime              @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy User?     @relation("MovementBy", fields: [createdById], references: [id])

  @@index([warehouseId, variantId])
  @@index([orderId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model StockReservation {
  id            String            @id @default(cuid())
  warehouseId   String
  variantId     String
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  agentUserId   String
  pageId        String?
  orderId       String?
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  releasedAt    DateTime?
  consumedAt    DateTime?

  variant ProductVariant @relation(fields: [variantId], references: [id])
  agent   User           @relation("AgentReservations", fields: [agentUserId], references: [id])
  page    FacebookPage?  @relation(fields: [pageId], references: [id])

  @@index([status, variantId])
  @@index([agentUserId])
  @@map("stock_reservations")
}

// ─── Customers ───────────────────────────────────────────

model Customer {
  id               String    @id @default(cuid())
  name             String
  phone            String    @unique
  whatsapp         String?
  city             String?
  area             String?
  address          String?
  landmark         String?
  notes            String?
  totalOrders      Int       @default(0)
  totalPurchases   Decimal   @default(0)
  deliveredOrders  Int       @default(0)
  cancelledOrders  Int       @default(0)
  returnsCount     Int       @default(0)
  lastOrderAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders Order[]

  @@index([city])
  @@index([name])
  @@map("customers")
}

// ─── Facebook Pages ──────────────────────────────────────

model FacebookPage {
  id         String             @id @default(cuid())
  name       String
  /// Public numeric Page ID used in referral links, e.g. 1025
  publicCode Int                @unique
  pageId     String?            @unique
  status     FacebookPageStatus @default(ACTIVE)
  managerId  String?
  /// Dedicated login for the page (like branch POS accounts)
  username     String?          @unique
  passwordHash String?          @map("password_hash")
  portalUserId String?          @unique
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  manager         User?                     @relation("PageManager", fields: [managerId], references: [id])
  portalUser      User?                     @relation("PagePortalUser", fields: [portalUserId], references: [id])
  employees       FacebookPageEmployee[]
  orders          Order[]
  reservations    StockReservation[]
  referralVisits  ReferralVisit[]
  shippingAccount ExternalShippingAccount?

  @@map("facebook_pages")
}

model FacebookPageEmployee {
  pageId     String
  userId     String
  role       PageMemberRole @default(AGENT)
  /// Public numeric Agent ID used in referral links, e.g. 2050
  agentCode  Int?           @unique
  assignedAt DateTime       @default(now())

  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pageId, userId])
  @@index([agentCode])
  @@map("facebook_page_employees")
}

model ReferralVisit {
  id           String   @id @default(cuid())
  pageId       String
  pageCode     Int
  agentUserId  String?
  agentCode    Int?
  attributionToken String @unique
  ip           String?
  userAgent    String?
  landingPath  String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  page FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([pageCode, agentCode])
  @@index([attributionToken])
  @@map("referral_visits")
}

model CodeSequence {
  key     String @id
  counter Int    @default(1000)

  @@map("code_sequences")
}

// ─── Orders ──────────────────────────────────────────────

model OrderSequence {
  year    Int @id
  counter Int @default(0)

  @@map("order_sequences")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  /// Scannable barcode, e.g. ORD-10025
  orderBarcode    String        @unique
  source          OrderSource
  status          OrderStatus   @default(NEW)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  deliveryType    DeliveryType  @default(INTERNAL)

  /// توجيه ذكي: داخلي (طرابلس) أو خارجي (المعيار)
  fulfillmentType FulfillmentType?
  /// دورة حياة الطلبات الداخلية للمناديب
  localStatus     LocalOrderStatus?
  courierId       String?

  customerId      String?
  salesAgentId    String?
  cashierId       String?
  createdById     String?
  facebookPageId  String?
  warehouseId     String?
  branchId        String?

  /// Attribution snapshot
  pagePublicCode  Int?
  agentPublicCode Int?
  referralVisitId String?
  attributionSource String?
  /// مصدر الصفحة الفرعية (اسم/رمز) لربط حساب المعيار
  pageSource      String?

  subtotal        Decimal
  discountAmount  Decimal       @default(0)
  promoCodeId     String?
  promoCode       String?
  deliveryFee     Decimal       @default(0)
  taxAmount       Decimal       @default(0)
  totalAmount     Decimal
  currency        String        @default("LYD")

  shippingName    String?
  shippingPhone   String?
  city            String?
  area            String?
  /// نوع المندوب داخل طرابلس: رجالي / نسائي
  deliveryGender  DeliveryGender?
  address         String?
  landmark        String?
  notes           String?

  /// بيانات الشحن الخارجي (المعيار)
  externalTrackingNumber String?
  shippingLabelUrl       String?
  externalResponsePayload String?
  fulfillmentError       String?

  stockDeductedAt   DateTime?
  returnedToStockAt DateTime?

  confirmedAt     DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer      Customer?      @relation(fields: [customerId], references: [id])
  salesAgent    User?          @relation("SalesAgentOrders", fields: [salesAgentId], references: [id])
  cashier       User?          @relation("CashierOrders", fields: [cashierId], references: [id])
  createdBy     User?          @relation("CreatedByOrders", fields: [createdById], references: [id])
  facebookPage  FacebookPage?  @relation(fields: [facebookPageId], references: [id])
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  referralVisit ReferralVisit? @relation(fields: [referralVisitId], references: [id])
  courier       Courier?       @relation(fields: [courierId], references: [id])
  items         OrderItem[]
  deliveries    Delivery[]
  invoice       Invoice?
  commissions   CommissionEntry[]

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([customerId])
  @@index([salesAgentId])
  @@index([createdById])
  @@index([facebookPageId])
  @@index([orderBarcode])
  @@index([pagePublicCode, agentPublicCode])
  @@index([fulfillmentType])
  @@index([localStatus])
  @@index([courierId])
  @@index([branchId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String?
  productName String
  variantName String?
  sku         String?
  imageUrl    String?
  quantity    Int
  unitPrice   Decimal
  discount    Decimal @default(0)
  lineTotal   Decimal

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ─── Delivery ────────────────────────────────────────────

/// مناطق طرابلس وأسعار التوصيل الرجالي والنسائي
model DeliveryZone {
  id        String   @id @default(cuid())
  city      String   @default("طرابلس")
  area      String
  maleFee   Decimal  @default(15)
  femaleFee Decimal  @default(20)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, area])
  @@index([city, isActive])
  @@map("delivery_zones")
}

/// مناديب التوصيل المحلي داخل طرابلس فقط
model Courier {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  isActive   Boolean   @default(true)
  notes      String?
  city       String    @default("طرابلس")
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?
  /// ربط بحساب مستخدم النظام (دور مندوب) لتسجيل الدخول
  userId     String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([isActive])
  @@index([city])
  @@map("couriers")
}

/// حسابات Accuratess / المعيار لكل صفحة تسويقية فرعية
model ExternalShippingAccount {
  id              String   @id @default(cuid())
  facebookPageId  String   @unique
  /// اسم تعريفي مثل لافينا / دار الأنوثة
  label           String?
  pageIdentifier  String?
  provider        String   @default("ACCURATESS")
  apiToken        String
  endpoint        String?
  senderZoneId    String?
  senderSubzoneId String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facebookPage FacebookPage @relation(fields: [facebookPageId], references: [id], onDelete: Cascade)

  @@index([pageIdentifier])
  @@index([isActive])
  @@map("external_shipping_accounts")
}

model DeliveryCompany {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String?
  phone     String?
  apiUrl    String?
  apiKey    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries Delivery[]

  @@map("delivery_companies")
}

model Delivery {
  id                String         @id @default(cuid())
  orderId           String
  type              DeliveryType
  status            DeliveryStatus @default(PENDING)
  agentId           String?
  companyId         String?
  trackingNumber    String?
  shippingSlipNo    String?        @unique
  /// Accuratess shipment id / code
  externalRef       String?
  trackingUrl       String?
  lastSyncedAt      DateTime?
  fee               Decimal        @default(0)
  notes             String?
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent   User?            @relation("DeliveryAgent", fields: [agentId], references: [id])
  company DeliveryCompany? @relation(fields: [companyId], references: [id])

  @@index([status])
  @@index([orderId])
  @@index([externalRef])
  @@map("deliveries")
}

// ─── Invoices ────────────────────────────────────────────

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String   @unique
  amount        Decimal 
  currency      String   @default("LYD")
  issuedAt      DateTime @default(now())
  notes         String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// ─── Audit ───────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Commissions ─────────────────────────────────────────

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model CommissionRule {
  id           String   @id @default(cuid())
  nameAr       String
  /// PERCENT of order total, or FIXED amount
  type         String   @default("PERCENT")
  ratePercent  Decimal? @default(0)
  fixedAmount  Decimal? @default(0)
  pageId       String?
  agentUserId  String?
  source       String?  /// FACEBOOK | POS | WEBSITE | ALL
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([pageId, agentUserId, isActive])
  @@map("commission_rules")
}

model CommissionEntry {
  id            String           @id @default(cuid())
  orderId       String
  agentUserId   String
  pageId        String?
  ruleId        String?
  orderTotal    Decimal
  itemCount     Int              @default(0)
  ratePercent   Decimal          @default(0)
  amount        Decimal
  currency      String           @default("LYD")
  status        CommissionStatus @default(PENDING)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  paidAt        DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent User  @relation("AgentCommissions", fields: [agentUserId], references: [id])

  @@unique([orderId, agentUserId])
  @@index([agentUserId, status])
  @@index([createdAt])
  @@map("commission_entries")
}

model SalaryPayment {
  id        String              @id @default(cuid())
  userId    String
  year      Int
  month     Int
  amount    Decimal
  status    SalaryPaymentStatus @default(PENDING)
  paidAt    DateTime?
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, status])
  @@map("salary_payments")
}

// ─── Marketing ───────────────────────────────────────────

enum PromoDiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id         String            @id @default(cuid())
  code       String            @unique
  nameAr     String?
  type       PromoDiscountType @default(PERCENT)
  value      Decimal
  minOrder   Decimal           @default(0)
  maxUses    Int?
  usedCount  Int               @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([active, startsAt, endsAt])
  @@map("promo_codes")
}

model Banner {
  id         String    @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String?
  linkUrl    String?
  /// HERO = سلايدر الرئيسية، PROMO = لافتات أسفل السلايدر
  placement  String    @default("PROMO")
  /// cover = ملء الإطار، contain = إظهار الصورة كاملة
  imageFit   String    @default("cover")
  imageZoom  Int       @default(100)
  imagePosX  Int       @default(50)
  imagePosY  Int       @default(50)
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([placement, active, sortOrder])
  @@map("banners")
}

// ─── Notifications ───────────────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  userId     String
  titleAr    String
  bodyAr     String?
  type       String
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ─── Mobile sessions & devices ───────────────────────────

model AuthSession {
  id               String         @id @default(cuid())
  userId           String
  refreshTokenHash String         @unique
  deviceId         String?
  platform         ClientPlatform @default(WEB)
  appVersion       String?
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Device {
  id           String         @id @default(cuid())
  userId       String?
  deviceId     String         @unique
  platform     ClientPlatform
  pushToken    String?
  pushProvider PushProvider?
  appVersion   String?
  osVersion    String?
  locale       String?        @default("ar")
  lastSeenAt   DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pushToken])
  @@map("devices")
}
