# Runtime template for official nginx image:
#   /etc/nginx/templates/default.conf.template → conf.d/default.conf (envsubst)
#
# Railway: public HTTPS (443) terminates at the edge; container must listen on $PORT (HTTP).
# Do NOT listen on 443 or configure SSL here — there are no certs inside the image.
# HTTP→HTTPS is enforced via X-Forwarded-Proto (see $https_force_redirect in nginx.main.conf).
#
# API_UPSTREAM:
#   Docker Compose → api:3000
#   Railway private → <backend-service>.railway.internal:8080
#
# PORT: Railway injects this (often 8080). Compose defaults to 80.

server {
    # IPv4 only — safer on hosts without usable IPv6 (failed [::] bind kills nginx)
    listen ${PORT};
    server_name _;

    client_max_body_size 8m;

    # Avoid http://host:PORT redirects that break behind Railway TLS
    absolute_redirect off;
    port_in_redirect off;

    # Docker embedded DNS + Railway private-network DNS
    resolver 127.0.0.11 [fd12::10] ipv6=on valid=10s;

    root /usr/share/nginx/html;
    index index.html;

    # Variable forces runtime DNS (avoids "host not found in upstream" at boot)
    set $api_upstream "${API_UPSTREAM}";

    # Strict HTTPS for browsers hitting http://… (Railway sets X-Forwarded-Proto)
    # Skip when header is missing (local Compose) or already https — prevents redirect loops.
    set $need_https_redirect $https_force_redirect;
    if ($uri = /healthz) {
        set $need_https_redirect 0;
    }
    if ($need_https_redirect = 1) {
        return 301 https://$host$request_uri;
    }

    # Canonical host: www.daralonotha.com → https://daralonotha.com
    # Requires BOTH hostnames added as custom domains on the Railway web service.
    if ($host = www.daralonotha.com) {
        return 301 https://daralonotha.com$request_uri;
    }

    # Tell browsers to prefer HTTPS after first secure visit
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://$api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
    }

    location /uploads/ {
        alias /var/www/uploads/;
        expires 30d;
        add_header Cache-Control "public";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri @uploads_api;
    }

    location @uploads_api {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
    }

    location /r/ {
        proxy_pass http://$api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Port $forwarded_port;
    }

    location /.well-known/ {
        proxy_pass http://$api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /admin {
        try_files $uri $uri/ /admin/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

